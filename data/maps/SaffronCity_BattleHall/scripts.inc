SaffronCity_BattleHall_MapScripts::
	.byte 0

SaffronCity_BattleHall_EventScript_KantoTrainer::
	trainerbattle_single TRAINER_BATTLE_HALL_KANTO, SaffronCity_BattleHall_Text_KantoTrainerIntro, SaffronCity_BattleHall_Text_KantoTrainerDefeat, SaffronCity_BattleHall_EventScript_DefeatedBattleHallTrainer
	goto_if_set FLAG_CHOSE_KANTO_POKEMON, SaffronCity_BattleHall_EventScript_GoodChoiceKanto
	msgbox SaffronCity_Dojo_Text_ChoosePrizedFightingMon, MSGBOX_AUTOCLOSE
	end

SaffronCity_BattleHall_EventScript_GoodChoiceKanto::
	msgbox SaffronCity_BattleHall_Text_PickedKanto
	release
	end

